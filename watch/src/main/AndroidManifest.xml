<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Standalone Wear OS app (does not require phone app) -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Network access for openHAB REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Speech recognition for voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Modify audio settings (unmute for TTS notifications) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Post notifications (required since API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibrate for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service for audio playback (prevents process kill and AudioHardening mute) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Wake lock for tile updates and background work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Re-register assistant after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required to register as system assistant (granted via ADB during setup) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />


    <application
        android:name=".OpenHabWearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Metadata declaring this is a standalone Wear OS app -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Main Activity (setup / item browser) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WearOH.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice Command Activity (also handles system ASSIST action) -->
        <activity
            android:name=".ui.voice.VoiceCommandActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Theme Picker (launched by system pencil on tile long-press) -->
        <activity
            android:name=".ui.tile.ThemePickerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="org.openhab.habdroid.wear.tile.CONFIG_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.google.android.clockwork.tiles.category.PROVIDER_CONFIG" />
            </intent-filter>
        </activity>

        <!-- Setup / Onboarding — handled by phone companion app -->

        <!-- Tile Action Receiver (handles toggle commands from tile taps, with optional confirmation) -->
        <activity
            android:name=".tile.TileActionReceiver"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Quick Action Activity (single tap = toggle, double tap = secondary action) -->
        <activity
            android:name=".tile.QuickActionActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Page Navigation Activity (handles page switches with optional credential confirmation) -->
        <activity
            android:name=".tile.PageNavigationActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Rotary Control Activity (for range/dimmer items) -->
        <activity
            android:name=".ui.control.RotaryControlActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Color Picker Activity (for Color items) -->
        <activity
            android:name=".ui.control.ColorPickerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Roller Shutter Activity (UP/STOP/DOWN + percentage) -->
        <activity
            android:name=".ui.control.RollerShutterActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Choice Picker Activity (for items with commandOptions) -->
        <activity
            android:name=".ui.control.ChoicePickerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Toggle Control Activity (for Switch items from complication tap) -->
        <activity
            android:name=".ui.control.ToggleControlActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Debug: inject credentials via ADB -->
        <activity
            android:name=".ui.setup.DebugSetupActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- About screen -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Settings screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Debug: grid preview -->
        <activity
            android:name=".ui.GridPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Speak Display Activity (shows message text during TTS/audio playback) -->
        <activity
            android:name=".notification.SpeakDisplayActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- openHAB Tile Service -->
        <service
            android:name=".tile.OpenHabTileService"
            android:exported="true"
            android:label="@string/tile_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />

            <meta-data
                android:name="com.google.android.clockwork.tiles.PROVIDER_CONFIG_ACTION"
                android:value="org.openhab.habdroid.wear.tile.CONFIG_ACTION" />
        </service>

        <!-- Complication Data Source Service -->
        <service
            android:name=".complication.OpenHabComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT,MONOCHROMATIC_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
            <meta-data
                android:name="android.support.wearable.complications.PROVIDER_CONFIG_ACTION"
                android:value="org.openhab.habdroid.wear.complication.CONFIG" />
        </service>

        <!-- Complication Detail Activity (shows fresh value on tap) -->
        <activity
            android:name=".complication.ComplicationDetailActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Complication Tap Action (routes to control or toggle based on item type) -->
        <activity
            android:name=".complication.ComplicationTapActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Complication Configuration Activity (item picker) -->
        <activity
            android:name=".complication.ComplicationConfigActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="org.openhab.habdroid.wear.complication.CONFIG" />
                <category android:name="android.support.wearable.complications.category.PROVIDER_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Disable default WorkManager initializer (using Hilt on-demand initialization) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Data Layer listener for phone credential sync -->
        <service
            android:name=".sync.WearDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/openhab" />
            </intent-filter>
        </service>

        <!-- FCM Message Listener for push notifications from openHAB Cloud -->
        <service
            android:name=".notification.FcmMessageListenerService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Foreground service for audio playback during notifications -->
        <service
            android:name=".notification.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Voice Interaction Service (registers this app as a selectable assistant) -->
        <service
            android:name=".ui.voice.OpenHabVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- Voice Interaction Session Service (creates voice sessions) -->
        <service
            android:name=".ui.voice.OpenHabVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Re-registers assistant after reinstall or reboot -->
        <receiver
            android:name=".ui.voice.AssistantBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
