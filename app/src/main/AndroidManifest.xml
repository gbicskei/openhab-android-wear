<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Standalone Wear OS app (does not require phone app) -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Network access for openHAB REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Speech recognition for voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Wake lock for tile updates and background work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for WorkManager -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".OpenHabWearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Metadata declaring this is a standalone Wear OS app -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Main Activity (setup / item browser) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice Command Activity -->
        <activity
            android:name=".ui.voice.VoiceCommandActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Theme Picker (launched by system pencil on tile long-press) -->
        <activity
            android:name=".ui.tile.ThemePickerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="org.openhab.habdroid.wear.tile.CONFIG_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.google.android.clockwork.tiles.category.PROVIDER_CONFIG" />
            </intent-filter>
        </activity>

        <!-- Setup / Onboarding Activity -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Tile Action Receiver (handles toggle commands from tile taps) -->
        <activity
            android:name=".tile.TileActionReceiver"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Page Navigation Activity (handles page switches with optional credential confirmation) -->
        <activity
            android:name=".tile.PageNavigationActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Rotary Control Activity (for range/dimmer items) -->
        <activity
            android:name=".ui.control.RotaryControlActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Debug: inject credentials via ADB -->
        <activity
            android:name=".ui.setup.DebugSetupActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- About screen -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Debug: grid preview -->
        <activity
            android:name=".ui.GridPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- openHAB Tile Service -->
        <service
            android:name=".tile.OpenHabTileService"
            android:exported="true"
            android:label="@string/tile_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />

            <meta-data
                android:name="com.google.android.clockwork.tiles.PROVIDER_CONFIG_ACTION"
                android:value="org.openhab.habdroid.wear.tile.CONFIG_ACTION" />
        </service>

        <!-- FCM Notification Service -->
        <service
            android:name=".notification.FcmListenerService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Disable default WorkManager initializer (using Hilt on-demand initialization) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
